{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    // Bugfix: runtime feature helper 有意以 JS 形式存放，使 Node prepare 脚本与 TypeScript 包
    // 在 shared 构建前即可导入同一份运行时契约。
    // 允许 shared 编译复制该 JS，避免 dist/index.js 导出一个不存在的文件。
    "allowJs": true
  },
  "include": ["src"],
  // 源码态 Vite/Node 配置需要真实 JS；显式保留它，避免同名类型声明使 tsc 跳过复制。
  "files": ["src/privacyNetwork.js"]
}
